# ============================================================
# proyecto_01 — Stack MLOps (Airflow + MLflow + MinIO + Postgres)
# Copiar a .env y completar. NO commitear .env.
# ============================================================

# AIRFLOW CONFIGURATION
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=CHANGE_ME
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# POSTGRESQL AIRFLOW
POSTGRES_AIRFLOW_USER=CHANGE_ME
POSTGRES_AIRFLOW_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_AIRFLOW_DB=airflow
POSTGRES_AIRFLOW_PORT=5432

# POSTGRESQL MLFLOW
POSTGRES_MLFLOW_USER=CHANGE_ME
POSTGRES_MLFLOW_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_MLFLOW_DB=mlflow_db
POSTGRES_MLFLOW_PORT=5433

# MINIO CONFIGURATION
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MINIO_BUCKET=mlflows3
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# MLFLOW CONFIGURATION
MLFLOW_PORT=5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=CHANGE_ME  # debe coincidir con MINIO_ROOT_USER
AWS_SECRET_ACCESS_KEY=CHANGE_ME_STRONG_PASSWORD  # debe coincidir con MINIO_ROOT_PASSWORD

# PGADMIN CONFIGURATION
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PGADMIN_PORT=5050

# JUPYTERLAB CONFIGURATION
JUPYTER_PORT=8888
JUPYTER_TOKEN=CHANGE_ME_RANDOM_TOKEN  # Fase 4.4 — auth real

# REDIS CONFIGURATION
REDIS_PORT=6379

# AIRFLOW FERNET (Fase 4.5 — generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW_FERNET_KEY=

# ============================================================
# OBSERVABILIDAD (Lote 1 — REQ-002)
# ============================================================

# API DE DATOS (batcher FastAPI)
API_DATOS_PORT=8000

# API DE INFERENCIA (Lote 2)
API_PREDICT_PORT=8001

# API SERVING C3 MME (Fase MME-F)
API_PREDICT_MME_PORT=8001

# FRONTEND C3 MME (Fase MME-F) — Next.js 14 App Router
FRONTEND_MME_PORT=3001

# PROMETHEUS + GRAFANA
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# EXPORTERS
CADVISOR_PORT=8082
NODE_EXPORTER_PORT=9100
STATSD_EXPORTER_PORT=9102
PUSHGATEWAY_PORT=9091

# MODELO EN PRODUCCIÓN
MODEL_NAME=rugpull_baseline_binary
MODEL_STAGE=Production
LABEL_MODE=binary

# FRONTEND (Lote 4 — REQ-002)
# Next.js App Router — consume api_predict vía server actions (URLs server-only, no llegan al browser).
FRONTEND_PORT=3001
