# Vigilancia Obstétrica Municipal — k8s/.env.example
# Copiar a k8s/.env (gitignored) y rellenar.
# Generar passwords con: openssl rand -hex 24

# ---------------------------------------------------------------------------
# Cluster / Networking
# ---------------------------------------------------------------------------

# IP externa del nodo MicroK8s (single-node = localhost en dev, IP real en VPS).
# Usada para construir URLs externas y para que el frontend sepa dónde está la API.
MICROK8S_NODE_IP=127.0.0.1

# NodePorts (rango K8s: 30000-32767). No cambiar salvo conflicto.
MLFLOW_NODEPORT=30500
MINIO_API_NODEPORT=30900
MINIO_CONSOLE_NODEPORT=30901
API_PREDICT_NODEPORT=30601
FRONTEND_NODEPORT=30602
AIRFLOW_NODEPORT=30080
JUPYTER_NODEPORT=30888
PGADMIN_NODEPORT=30050
PGADMIN_DEFAULT_EMAIL=admin@mme.local
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin

# ---------------------------------------------------------------------------
# Internal URLs (DNS K8s, pod-a-pod). NO tocar salvo cambio de namespace.
# ---------------------------------------------------------------------------

MLFLOW_INTERNAL_URL=http://mlflow-tracking.mlflow.svc.cluster.local:80
MINIO_INTERNAL_S3=http://minio.data.svc.cluster.local:9000
POSTGRES_AIRFLOW_HOST=postgres-airflow.airflow.svc.cluster.local
POSTGRES_AIRFLOW_PORT=5432
POSTGRES_MLFLOW_HOST=postgres-mlflow.mlflow.svc.cluster.local
POSTGRES_MLFLOW_PORT=5432
REDIS_HOST=airflow-redis-master.airflow.svc.cluster.local
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# External URLs (para que frontend muestre links útiles al usuario final).
# ---------------------------------------------------------------------------

MLFLOW_EXTERNAL_URL=http://${MICROK8S_NODE_IP}:${MLFLOW_NODEPORT}
API_PREDICT_EXTERNAL_URL=http://${MICROK8S_NODE_IP}:${API_PREDICT_NODEPORT}
FRONTEND_EXTERNAL_URL=http://${MICROK8S_NODE_IP}:${FRONTEND_NODEPORT}

# ---------------------------------------------------------------------------
# Credenciales (van a Secrets K8s, no a ConfigMaps).
# Generar todas con: openssl rand -hex 24
# ---------------------------------------------------------------------------

# Postgres Airflow (chart bitnami/postgresql)
POSTGRES_AIRFLOW_DB=airflow
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=changeme-airflow

# Postgres MLflow
POSTGRES_MLFLOW_DB=mlflow
POSTGRES_MLFLOW_USER=mlflow
POSTGRES_MLFLOW_PASSWORD=changeme-mlflow

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-minio-root

# Airflow runtime secrets
# AIRFLOW_FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=changeme-fernet-44chars-base64
# AIRFLOW_SECRET_KEY: openssl rand -hex 32
AIRFLOW_SECRET_KEY=changeme-secret-64hex
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme-admin

# Redis password (opcional pero recomendado en chart bitnami/redis)
REDIS_PASSWORD=changeme-redis

# ---------------------------------------------------------------------------
# Buckets S3 (MinIO) para artifacts.
# ---------------------------------------------------------------------------

MLFLOW_S3_BUCKET=mlflows3
MLFLOW_S3_ENDPOINT_URL=${MINIO_INTERNAL_S3}
AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}

# ---------------------------------------------------------------------------
# MLflow
# ---------------------------------------------------------------------------

MLFLOW_TRACKING_URI=${MLFLOW_INTERNAL_URL}
MLFLOW_EXPERIMENT_NAME=mme_vulnerability_v1
MLFLOW_REGISTRY_MODEL_NAME=mme_vulnerability_baseline

# ---------------------------------------------------------------------------
# API Predict MME (FastAPI)
# ---------------------------------------------------------------------------

API_MME_CI_ALPHA=0.10
API_MME_BOOTSTRAP_REPLICATES=200
API_MME_PANEL_CACHE_TTL_SECONDS=3600
API_MME_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Frontend MME (Next.js)
# ---------------------------------------------------------------------------

API_PREDICT_MME_URL=${API_PREDICT_EXTERNAL_URL}
NEXT_PUBLIC_DISCLAIMER_ENABLED=true

# ---------------------------------------------------------------------------
# Imágenes Docker Hub (bumped por GHA build-and-push.yml)
# ---------------------------------------------------------------------------

DOCKERHUB_USER=luisfrontuso10
IMAGE_TAG_API_PREDICT=latest
IMAGE_TAG_FRONTEND=latest
IMAGE_TAG_MLFLOW=latest
IMAGE_TAG_AIRFLOW=latest
IMAGE_TAG_JUPYTER=latest

# ---------------------------------------------------------------------------
# Storage (PVC sizes — chart values lo respetan)
# ---------------------------------------------------------------------------

PVC_POSTGRES_AIRFLOW_SIZE=10Gi
PVC_POSTGRES_MLFLOW_SIZE=10Gi
PVC_MINIO_SIZE=50Gi
PVC_JUPYTER_SIZE=5Gi
PVC_AIRFLOW_LOGS_SIZE=20Gi

# ---------------------------------------------------------------------------
# GitOps (ArgoCD)
# ---------------------------------------------------------------------------

GITOPS_REPO_URL=git@github.com:ftuga/Vigilancia-Obst-trica-Municipal.git
GITOPS_BRANCH=main
GITOPS_K8S_PATH=k8s
